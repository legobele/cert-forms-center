<?xml version="1.0" encoding="UTF-8"?>
<!-- CERT Form Template — FEMA CERT Unidad 6: Documentación
     id: communications_log | version: 1 | labels: ES (primario), EN (secundario)
     Uso: registra las transmisiones entrantes y salientes; normalmente lo mantiene el operador de radio. -->
<form id="communications_log" version="1" lang="es">
  <meta>
    <title>Registro de comunicaciones</title>
    <title_en>Communications Log</title_en>
    <source>FEMA CERT — Unidad 6: Organización del CERT / Documentación</source>
  </meta>
  <header>
    <field name="date" type="date" label="Fecha" label_en="Date" required="true"/>
    <field name="radio_operator" type="text" label="Operador de radio" label_en="Radio operator"/>
    <field name="frequency_net" type="text" label="Frecuencia / red" label_en="Frequency / net"/>
    <field name="page" type="text" label="Página ___ de ___" label_en="Page ___ of ___"/>
  </header>
  <tables>
    <table name="comm_rows" label="Transmisiones" label_en="Transmissions" min_rows="14">
      <column name="time" type="time" label="Hora" label_en="Time"/>
      <column name="from" type="text" label="De" label_en="From"/>
      <column name="to" type="text" label="Para" label_en="To"/>
      <column name="message" type="text" label="Mensaje" label_en="Message"/>
      <column name="action" type="text" label="Acción tomada" label_en="Action taken"/>
    </table>
  </tables>
  <footer>
    <field name="operator_signature" type="signature" label="Firma del operador" label_en="Operator signature"/>
  </footer>
</form>
