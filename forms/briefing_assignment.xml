<?xml version="1.0" encoding="UTF-8"?>
<!-- CERT Form Template — FEMA CERT Unidad 6: Documentación
     id: briefing_assignment | version: 1 | labels: ES (primario), EN (secundario)
     Uso: frente = instrucciones del puesto de mando al equipo; reverso = registro de acciones del equipo. Se devuelve al puesto de mando al finalizar. -->
<form id="briefing_assignment" version="1" lang="es">
  <meta>
    <title>Formulario de briefing / asignación</title>
    <title_en>Briefing Assignment Form</title_en>
    <source>FEMA CERT — Unidad 6: Organización del CERT / Documentación</source>
  </meta>
  <header>
    <field name="incident_name" type="text" label="Nombre del incidente" label_en="Incident name" required="true"/>
    <field name="date" type="date" label="Fecha" label_en="Date" required="true"/>
    <field name="time" type="time" label="Hora" label_en="Time"/>
    <field name="team" type="text" label="Equipo" label_en="Team"/>
    <field name="team_leader" type="text" label="Líder del equipo" label_en="Team leader"/>
    <field name="location_address" type="text" label="Dirección / ubicación del incidente" label_en="Incident address / location"/>
    <field name="incident_type" type="select" label="Tipo de incidente" label_en="Incident type">
      <option value="fire" label="Incendio" label_en="Fire"/>
      <option value="search_rescue" label="Búsqueda y rescate" label_en="Search and rescue"/>
      <option value="medical" label="Médico" label_en="Medical"/>
      <option value="damage_assessment" label="Evaluación de daños" label_en="Damage assessment"/>
      <option value="other" label="Otro" label_en="Other"/>
    </field>
    <field name="objectives" type="textarea" label="Objetivos de la asignación" label_en="Assignment objectives"/>
    <field name="safety_notes" type="textarea" label="Notas de seguridad" label_en="Safety notes"/>
    <field name="issued_by" type="text" label="Emitido por" label_en="Issued by"/>
  </header>
  <tables>
    <table name="action_log" label="Registro de acciones del equipo (reverso)" label_en="Team action log (back side)" min_rows="10">
      <column name="action_time" type="time" label="Hora" label_en="Time"/>
      <column name="action" type="text" label="Acción realizada" label_en="Action taken"/>
    </table>
  </tables>
  <footer>
    <field name="team_leader_signature" type="signature" label="Firma del líder del equipo (recibido)" label_en="Team leader signature (acknowledged)"/>
    <field name="returned_time" type="time" label="Hora de devolución al puesto de mando" label_en="Time returned to command post"/>
  </footer>
</form>
