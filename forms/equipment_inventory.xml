<?xml version="1.0" encoding="UTF-8"?>
<!-- CERT Form Template — FEMA CERT Unidad 6: Documentación
     id: equipment_inventory | version: 1 | labels: ES (primario), EN (secundario)
     Uso: se mantiene en el área o vehículo donde se almacena el equipo; registra entradas y salidas. -->
<form id="equipment_inventory" version="1" lang="es">
  <meta>
    <title>Inventario de equipo</title>
    <title_en>Equipment Inventory</title_en>
    <source>FEMA CERT — Unidad 6: Organización del CERT / Documentación</source>
  </meta>
  <header>
    <field name="date" type="date" label="Fecha" label_en="Date" required="true"/>
    <field name="storage_location" type="text" label="Ubicación de almacenamiento" label_en="Storage location"/>
    <field name="custodian" type="text" label="Responsable" label_en="Custodian"/>
    <field name="page" type="text" label="Página ___ de ___" label_en="Page ___ of ___"/>
  </header>
  <tables>
    <table name="equipment_rows" label="Equipo" label_en="Equipment" min_rows="12">
      <column name="item" type="text" label="Artículo" label_en="Item"/>
      <column name="quantity" type="number" label="Cantidad" label_en="Quantity"/>
      <column name="condition" type="select" label="Condición" label_en="Condition">
        <option value="good" label="Buena" label_en="Good"/>
        <option value="fair" label="Regular" label_en="Fair"/>
        <option value="poor" label="Mala" label_en="Poor"/>
      </column>
      <column name="checked_out_by" type="text" label="Retirado por" label_en="Checked out by"/>
      <column name="time_out" type="time" label="Hora de salida" label_en="Time out"/>
      <column name="time_in" type="time" label="Hora de devolución" label_en="Time returned"/>
      <column name="notes" type="text" label="Notas" label_en="Notes"/>
    </table>
  </tables>
  <footer>
    <field name="custodian_signature" type="signature" label="Firma del responsable" label_en="Custodian signature"/>
  </footer>
</form>
