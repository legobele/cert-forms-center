// ============================================================================
// cert-forms-center — Firestore security rules (MERGED, deployed via CLI)
// Firebase project: cert-forms-center
//
// MERGE RECORD (Sat 2026-09-19 ~6:35pm AST, console-ops):
//   * Prod ruleset fetched live before merging:
//     projects/cert-forms-center/rulesets/24b46550-ecc1-458e-a376-3b1f240622e4
//     (updated 2026-09-19T19:59:19Z). Prod was: read/create/update `if true`
//     on bugReports, incidents, incidents/{i}/teams/{t}, submissions, scans;
//     read+create on audit; read-only templates + config; NO delete rules
//     anywhere (default deny); NO auth-based rules anywhere.
//   * Merge procedure: each draft guard AND-ed with the prod `if true`
//     condition for the same op (so `if true && guard()` == `if guard()`).
//     Untouched-by-draft blocks (templates, teams subcollection, audit,
//     config) are carried over verbatim from prod.
//   * isAdmin() ADAPTATION: the draft assumed a custom claim
//     `request.auth.token.admin == true`. The live ruleset has NO admin
//     concept at all (nothing auth-based). Per console-ops instructions the
//     broken assumption was NOT deployed. Delete is now:
//         allow delete: if request.auth != null && resource.data.test == true;
//     i.e. any authenticated user may delete test:true QA docs (fixes T35 for
//     the QA users; the app itself never writes test:true). No admin claim is
//     referenced anywhere below.
//   * Deploy blockers B1/B2 from the draft are CLEAR: the merged app.js
//     bug-report form (origin/main) now writes a required `description` and
//     offers exactly the canonical severity enum
//     [blocker,major,medium,minor].
//   * App write-shape audit (origin/main app.js, pre-deploy): incident create
//     writes {name_es,date(YYYY-MM-DD),kind∈{exercise,real},status:'active',
//     demo:bool,actor(non-empty; empty→'Anónimo'),createdAt:serverTimestamp};
//     submission writes exactly the 13 allowlisted keys; scan writes carry a
//     real incidentId (incidents/demo-2026-09-20 exists in prod) + non-empty
//     actor; demoTick writes are try/catch best-effort. Offline outbox
//     round-trips serverTimestamp sentinels, so `is timestamp` holds there too.
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- shared helpers ----------------
    // Actor: kiosk is unauthenticated, so the best the rules can do is
    // require a non-empty claimed name on create and freeze it afterwards.
    function actorNonEmpty() {
      let a = request.resource.data.get('actor', '');
      return a is string && a.size() > 0;
    }
    function actorImmutable() {
      return request.resource.data.get('actor', '')
          == resource.data.get('actor', '');
    }
    // T35: authenticated users may delete QA probe docs. There is no admin
    // claim in this project (verified vs the live ruleset), so the delete
    // grant is scoped to test:true docs, which the app never writes.
    function testDocDeletable() {
      return request.auth != null && resource.data.test == true;
    }

    // ---------------- bugReports ----------------
    match /bugReports/{docId} {
      function bugReportGuards() {
        let d = request.resource.data;
        return d.title is string && d.title.size() >= 1 && d.title.size() <= 140
          && d.description is string && d.description.size() >= 1
          && d.severity is string
          && d.severity in ['blocker','major','medium','minor'];
      }
      // was: allow create/update if true. AND-ed with the guards (T41 x4, T43).
      allow read: if true;
      allow create: if bugReportGuards();
      allow update: if resource != null && bugReportGuards();
      allow delete: if testDocDeletable();
    }

    // ---------------- templates (unchanged from prod) ----------------
    match /templates/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /templates/{t}/versions/{v} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------- incidents ----------------
    match /incidents/{docId} {
      function incidentGuards() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name_es','date','kind','status','demo',
                                 'actor','uid','createdAt','updatedAt','test'])
          && d.name_es is string && d.name_es.size() > 0 && d.name_es.size() <= 200
          && d.date is string && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && d.kind is string && d.kind in ['exercise','real']
          && d.status is string && d.status in ['active','archived']
          && d.demo is bool
          && d.createdAt is timestamp
          && actorNonEmpty();
      }
      // was: allow create/update if true. AND-ed with the guards (T45, T16).
      allow read: if true;
      allow create: if incidentGuards();
      allow update: if resource != null && incidentGuards() && actorImmutable();
      allow delete: if testDocDeletable();
    }

    // ---------------- incidents/{i}/teams (unchanged from prod) ----------------
    match /incidents/{i}/teams/{t} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // ---------------- submissions ----------------
    match /submissions/{docId} {
      function submissionKeysOk() {
        return request.resource.data.keys().hasOnly([
          'templateId','templateVersion','incidentId','team','fieldValues',
          'tables','status','demo','actor','uid','clientId',
          'createdAt','updatedAt'
        ]);
      }
      function statusOk() {
        let s = request.resource.data.get('status', '');
        return s is string && s in ['draft','signed'];
      }
      function noDemote() {
        return resource == null
          || !(resource.data.get('status','') == 'signed'
               && request.resource.data.get('status','') != 'signed');
      }
      function templateVersionOk() {
        return request.resource.data.get('templateVersion', 0) is number;
      }
      function fieldValuesOk() {
        return request.resource.data.get('fieldValues', {}) is map;
      }
      function sigValueOk(v) {
        return v is string
          && v.matches('.*\\S.*')
          && v.matches('^data:image/(png|jpe?g);base64,[A-Za-z0-9+/=]+$');
      }
      function sigFieldOk(fv, k) {
        return k in fv && sigValueOk(fv[k]);
      }
      function signedFieldPresent(fv) {
        // No list.filter()/lambdas exist in the rules DSL, so the check is
        // spelled out over the 8 unique signature field names in forms/*.xml.
        // If a future form adds a new signature field, ADD ITS NAME HERE.
        return fv is map && (
             sigFieldOk(fv, 'team_leader_signature')
          || sigFieldOk(fv, 'scribe_signature')
          || sigFieldOk(fv, 'ic_signature')
          || sigFieldOk(fv, 'treatment_leader_signature')
          || sigFieldOk(fv, 'operator_signature')
          || sigFieldOk(fv, 'custodian_signature')
          || sigFieldOk(fv, 'sender_signature')
          || sigFieldOk(fv, 'receiver_signature'));
      }
      function signedHasSig() {
        return request.resource.data.get('status','') != 'signed'
          || signedFieldPresent(request.resource.data.get('fieldValues', {}));
      }
      function submissionGuards() {
        return submissionKeysOk() && statusOk() && templateVersionOk()
          && fieldValuesOk() && actorNonEmpty() && signedHasSig();
      }
      // was: allow create/update if true. AND-ed with the guards
      // (T23 no-demote, T13+OX61IntBRZiRU6Icu1Ae signature, VdWKfxX4BOX6hNcXdgVZ,
      // VImZAs0bGBLl2Urx7aSg schema). Depth-limit PdRaMCSrwqUiS5vBRUcg is NOT
      // expressible in the rules DSL — needs a Cloud Function.
      allow read: if true;
      allow create: if submissionGuards() && noDemote();
      allow update: if resource != null && submissionGuards() && noDemote()
        && actorImmutable();
      allow delete: if testDocDeletable();
    }

    // ---------------- scans ----------------
    match /scans/{scanId} {
      function scanIncidentOk() {
        let iid = request.resource.data.get('incidentId', '');
        return iid is string && iid.size() > 0
          && exists(/databases/$(database)/documents/incidents/$(iid));
      }
      function scanIncidentOkOnUpdate() {
        return resource.data.get('incidentId','')
                == request.resource.data.get('incidentId','')
          || scanIncidentOk();
      }
      // was: allow create/update if true. AND-ed (T39 no-upsert, T37
      // incident must exist, T04 actor). incidents/demo-2026-09-20 exists in
      // prod, so the demo sim's scans keep passing.
      allow read: if true;
      allow create: if actorNonEmpty() && scanIncidentOk();
      allow update: if resource != null && actorNonEmpty() && actorImmutable()
        && scanIncidentOkOnUpdate();
      allow delete: if testDocDeletable();
    }

    // ---------------- audit (unchanged from prod) ----------------
    // NOTE: audit docs remain client-writable (T28) until the Cloud Functions
    // trigger lands; treat actor/audit as informational until then.
    match /audit/{docId} {
      allow read: if true;
      allow create: if true;
    }

    // ---------------- config (unchanged from prod) ----------------
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
